{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["api/**/*.ts", "scripts/**/*.ts", "src/api/**/*.ts", "src/data/**/*.ts", "src/db/**/*.ts", "src/domain/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "api/**/*.test.ts"]
}
