# Copy to .env.local and fill in. Never commit the filled-in file.

# Neon (or any Postgres) pooled connection string.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# The exact origin the app is served from. Used as the CSRF check on writes,
# and as the base of the invite links `npm run setup` generates.
APP_ORIGIN=http://localhost:5173

# Web push. Optional — the app works without it, minus notifications.
# Generate a pair with:  npx web-push generate-vapid-keys
# The private key belongs only in your host's environment settings.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Catalog artwork comes from a keyless public catalog: there is no image API
# key to configure, ship, or rotate.
